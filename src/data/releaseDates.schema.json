{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boopurno.es/schemas/releaseDates.json",
  "title": "ReleaseDates",
  "type": "object",
  "required": ["supportCards", "trainees"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "defaultSource": { "type": "string", "format": "uri" },
        "builtFrom": {
          "type": "object",
          "properties": {
            "supportCardsUrl": { "type": "string", "format": "uri" },
            "characterCardsUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "supportCards": { "$ref": "#/$defs/idMap" },
    "trainees": { "$ref": "#/$defs/idMap" }
  },
  "$defs": {
    "releaseRow": {
      "type": "object",
      "required": ["release_global_is_approximate"],
      "additionalProperties": false,
      "properties": {
        "released_jp": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "released_global": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "release_global_is_approximate": { "type": "boolean" },
        "release_source": { "type": ["string", "null"] }
      }
    },
    "idMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/releaseRow" }
    }
  }
}
