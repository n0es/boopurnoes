# Local dev database (copy to .env.local and fill in your values)
# Default local Supabase postgres port is 54322
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Get these from: supabase status  OR  your local Supabase Studio → Settings → API

SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-local-service-role-key

# These are only needed for the frontend (Vite build-time)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Production (read-only) — used by db:sync to pull data and images
# Find these in: Supabase Dashboard → Project Settings → API
PROD_SUPABASE_URL=https://<project-ref>.supabase.co
PROD_SUPABASE_SERVICE_KEY=your-prod-service-role-key
