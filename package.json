{
  "name": "boopurnoes",
  "private": true,
  "version": "0.1.28",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:setup": "tsx scripts/setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:images": "tsx scripts/download-images.ts",
    "db:reset": "npm run db:setup && npm run db:seed && npm run db:images && npm run db:scrape-trainees && npm run db:trainee-images",
    "db:sync": "tsx scripts/sync-prod.ts",
    "db:import-user-collection": "tsx scripts/import-user-collection-from-prod.ts",
    "db:transfer-user-collection": "tsx scripts/transfer-user-collection.ts",
    "db:reset-trainees": "npm run db:scrape-trainees && npm run db:trainee-images",
    "db:import-trainees": "tsx scripts/import-trainees.ts",
    "db:scrape-trainees": "tsx scripts/scrape-trainees.ts",
    "db:trainee-images": "tsx scripts/download-trainee-images.ts",
    "db:skill-icons": "tsx scripts/download-skill-icons.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
